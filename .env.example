# ═══════════════════════════════════════════════════════════════════
# Local development environment for Capacity Command (Realtime)
# Copy to .env and `source .env` (or use scripts/run_local.sh which loads it).
# ═══════════════════════════════════════════════════════════════════

# ── Data source ──
DATA_SOURCE=lakebase

# ── Local Postgres (stands in for Lakebase) ──
PGHOST=localhost
PGPORT=5432
PGDATABASE=hospital_ops
PGUSER=$(whoami)
# PGPASSWORD=                       # leave unset for local trust/peer auth
LAKEBASE_SCHEMA=hospital_ops_lakebase

# ── Mode ──
# ENABLE_SIMULATION=true runs the built-in synthetic ADT generator: a live,
# moving census with no Redox feed and no Databricks jobs. Best for demos.
# Leave false for realtime mode (data arrives only from the ingest webhook).
ENABLE_SIMULATION=false
SITE_NAME=General Hospital
AUTO_CREATE_BEDS=true               # convenient locally; pre-seed a bed master in prod

# ── Ingestion auth (local: relaxed) ──
REQUIRE_INGEST_AUTH=false
# REDOX_VERIFICATION_TOKEN=local-dev-token
# REDOX_SIGNATURE_SECRET=local-dev-secret

# ── Location mapping ──
LOCATION_MAP_PATH=config/location_map.yaml

# ── Bronze landing (local: NDJSON file, no Databricks needed) ──
BRONZE_SINK=local
BRONZE_LOCAL_PATH=/tmp/redox_bronze.ndjson

# ── LLM (assistant/agents) — optional locally ──
# Point at your workspace to exercise the Copilot locally:
# DATABRICKS_PROFILE=DEFAULT
SERVING_ENDPOINT=databricks-claude-sonnet-4-5

# ── Delta bronze (only when BRONZE_SINK=delta) ──
# DELTA_CATALOG=main
# DELTA_BRONZE_SCHEMA=hospital_ops_bronze
# WAREHOUSE_ID=
